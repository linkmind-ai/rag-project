# Elasticsearch
ES_HOST=https://your-elasticsearch-host/
ES_INDEX=vector-test-index
ES_ID=your-elasticsearch-id
ES_API_KEY=your-elasticsearch-api-key
VEC_DIMS=1024

# Ollama
OLLAMA_HOST=https://your-ollama-host/
OLLAMA_MODEL=hf.co/LGAI-EXAONE/EXAONE-4.0-1.2B-GGUF:BF16
EMBEDDING_MODEL=bge-m3:latest

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
MAX_CONCURRENT_REQUESTS=5

# RAG Base
TOP_K_RESULTS=3
MAX_HISTORY_LENGTH=10

# PersonaRAG + Self-RAG (optional)
ROUTING_GATE_MODE=rule_llm_fallback
SELF_RAG_MAX_LOOPS=2
SELF_RAG_SEGMENT_MODE=sentence
SELF_RAG_PROFILE=balanced
MIN_UTILITY=3.5
MIN_AVG_REL=0.55
MAX_NO_SUPPORT_RATIO=0.30
MAX_PARTIAL_OR_NO_RATIO=0.55
MIN_FULL_SUPPORT_RATIO_HIGH_RISK=0.75

# Notion (optional)
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# Ragas + Vertex AI evaluation (optional)
# Preferred: rotate any previously exposed key, then put the new key here.
# If VERTEX_API_KEY is set, the eval script uses Vertex AI express mode.
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
RAGAS_VERTEX_MODEL=gemini-2.5-flash
RAGAS_VERTEX_EMBEDDING_MODEL=gemini-embedding-001
RAGAS_QUERY_API_URL=http://127.0.0.1:8000/query
RAGAS_GOLDEN_SET=tests/golden_set_100.json
RAGAS_OUTPUT_PREFIX=.benchmarks/ragas_vertex_eval_golden_set_100
RAGAS_CACHE_PATH=.benchmarks/ragas_vertex_eval_golden_set_100_samples.json
RAGAS_PERSONA_FILE=
